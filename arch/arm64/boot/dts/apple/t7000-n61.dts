/dts-v1/;

#include "t7000-6.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/ti-drv260x.h>

/ {
	compatible = "apple,n61", "apple,t7000", "apple,arm-platform";
	model = "Apple iPhone 6";

	/* PMU rails, not described yet (no driver for the PMU's regulators) */
	vreg_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "PP1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	vreg_vbat: regulator-vbat {
		compatible = "regulator-fixed";
		regulator-name = "VBAT";
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
		regulator-always-on;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "iPhone 6";
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * ADT audio-codec: ain1 "cimi" (bias 1), ain5 "cims" (bias 4),
		 * ain6 "cimf" (bias 3), ain2 = headset mic. Physical positions
		 * are a guess from teardowns.
		 */
		simple-audio-card,widgets =
			"Microphone", "Bottom Mic",
			"Microphone", "Rear Mic",
			"Microphone", "Front Mic",
			"Microphone", "Headset Mic",
			"Headphone", "Headphones";
		simple-audio-card,routing =
			"AIN1", "Bottom Mic",
			"Bottom Mic", "MICBIAS1",
			"AIN5", "Rear Mic",
			"Rear Mic", "MICBIAS4",
			"AIN6", "Front Mic",
			"Front Mic", "MICBIAS3",
			"HSMIC", "Headset Mic",
			"Headphones", "HPOUT";

		/* hw:0,0: speaker amp, slot 0 of MCA2's 8 x 16-bit frame */
		simple-audio-card,dai-link@0 {
			reg = <0>;
			format = "dsp_a";
			bitclock-master = <&speaker_cpu>;
			frame-master = <&speaker_cpu>;

			speaker_cpu: cpu {
				sound-dai = <&mca2 0>;
			};

			codec {
				sound-dai = <&speaker_amp>;
				/* MCLK pad = 24 MHz nclk / 2 */
				system-clock-frequency = <12000000>;
			};
		};

		/*
		 * hw:0,1: headset codec XSP on the same I2S bus (ADT xsp_active
		 * = pin2), MCA2 still the clock master. Capture = slots 4-7.
		 */
		simple-audio-card,dai-link@1 {
			reg = <1>;
			format = "dsp_a";
			bitclock-master = <&codec_cpu>;
			frame-master = <&codec_cpu>;

			codec_cpu: cpu {
				sound-dai = <&mca2 1>;
			};

			codec {
				sound-dai = <&headset_codec 0>;
			};
		};

		/*
		 * hw:0,2: the mics as iOS records them, codec ASP (I2S, 2 x
		 * 16-bit) on MCA0 / pin0, MCA0 the clock master. The codec's
		 * MCLK stays MCA0's pad 0.
		 */
		simple-audio-card,dai-link@2 {
			reg = <2>;
			format = "i2s";
			bitclock-master = <&mic_cpu>;
			frame-master = <&mic_cpu>;

			mic_cpu: cpu {
				sound-dai = <&mca0 1>;
			};

			codec {
				sound-dai = <&headset_codec 1>;
			};
		};

		/*
		 * hw:0,3: baseband voice PCM (ADT mca3/audio-baseband-voice): I2S,
		 * 2 x 16-bit slots, 8 kHz (narrowband) or 16 kHz (wideband), the
		 * modem is the clock master. The modem side is a plain PCM endpoint.
		 */
		simple-audio-card,dai-link@3 {
			reg = <3>;
			format = "i2s";
			bitclock-master = <&baseband_voice>;
			frame-master = <&baseband_voice>;

			cpu {
				sound-dai = <&mca3 1>;
			};

			baseband_voice: codec {
				sound-dai = <&baseband_pcm 1>;
			};
		};
	};

	/* the modem's voice PCM: mono, 8 / 16 kHz, it provides BCLK + FSYNC */
	baseband_pcm: baseband-pcm {
		compatible = "linux,bt-sco";
		#sound-dai-cells = <1>;
	};
};

&mca0 {
	/* MCA2 uses bytes 0-0xcb of both shim SRAM pools */
	apple,shim-sram-offset = <0x100>;
	status = "okay";
};

&mca2 {
	status = "okay";
};

&mca3 {
	/* after MCA2 (0-0xcb) and MCA0 (0x100-0x1cb) in both shim SRAM pools */
	apple,shim-sram-offset = <0x200>;
	status = "okay";
};

&pcie {
	status = "okay";
};

/*
 * The PCIe driver and the DART driver are modules in the Wi-Fi bring-up
 * config: the DART only answers once port 1 is enabled, so it has to be
 * loaded after pcie-apple.
 */
&dart_apcie1 {
	status = "okay";
};

/* ADT /arm-io/apcie/pci-bridge1: the Wi-Fi half of the BCM4345 module */
&port01 {
	/* ADT function-perst: GPIO 77 */
	reset-gpios = <&pinctrl 77 GPIO_ACTIVE_LOW>;
	/* ADT uart4/wlan function-reg_on: PMU GPIO 10 = WL_REG_ON */
	pwren-gpios = <&pmic_gpio 10 GPIO_ACTIVE_HIGH>;
	/* ADT maximum-link-speed */
	max-link-speed = <1>;
	/*
	 * iOS needs special L1SS handling (acpie-l1ss-workaround) and
	 * cannot touch config space in L1/L2: keep ASPM off.
	 */
	aspm-no-l0s;
	aspm-no-l1;
	aspm-no-l1ss;
	/* CLKREQ# (GPIO 41) and DEVICE_WAKE (GPIO 200) are not used */
	bus-range = <1 1>;
	status = "okay";

	wifi0: wifi@0,0 {
		compatible = "pci14e4,43ab";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		/* ADT module-instance: brcmfmac4345b1-pcie.apple,tempranillo.* */
		brcm,board-type = "apple,tempranillo";
	};
};

&i2c0 {
	/* Display PMU, only the touch analog supply switch is described */
	display-pmu@27 {
		compatible = "apple,chestnut";
		reg = <0x27>;

		regulators {
			chestnut_ldo2: ldo2 {
				regulator-name = "chestnut-ldo2";
			};
		};
	};
};

&i2c2 {
	status = "okay";

	/* ADT /arm-io/i2c2/als: "als,ct819", command-compatible with the TAOS TSL2581 */
	light-sensor@29 {
		compatible = "amstaos,tsl2581";
		reg = <0x29>;
		/* ADT interrupts [34 1] = level-low; the driver polls, the line is only described */
		interrupts-extended = <&pinctrl 34 IRQ_TYPE_LEVEL_LOW>;
	};
};

&i2c1 {
	status = "okay";

	haptics@5a {
		compatible = "ti,drv2604";
		reg = <0x5a>;
		enable-gpios = <&pinctrl 76 GPIO_ACTIVE_HIGH>;
		mode = <DRV260X_LRA_MODE>;
		library-sel = <DRV260X_LIB_LRA>;
		vib-rated-mv = <2140>;
		vib-overdrive-mv = <3320>;
	};

	charger: charger@75 {
		compatible = "ti,sn2400";
		reg = <0x75>;
		/*
		 * INT on PMU GPIO 0 = PMU event 24 (ADT tigris: interrupts
		 * <24>, parent = pmu), a level input. PMU event 3 ("usb") is
		 * not wired on N61: iOS asks the charger instead (ADT pmu
		 * function-get_vbus_detect), and it never fires on a re-plug.
		 */
		interrupts-extended = <&pmic_irq 24 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "irq";
		wakeup-source;
		input-current-limit-microamp = <500000>;
		constant-charge-current-max-microamp = <1000000>;
	};

	/*
	 * Values from the "speaker-config" property of the iOS device tree.
	 * The IRQ (GPIO 47) is left out until its polarity is known.
	 */
	speaker_amp: speaker-amp@40 {
		compatible = "cirrus,cs35l19";
		reg = <0x40>;
		reset-gpios = <&pinctrl 49 GPIO_ACTIVE_HIGH>;
		VA-supply = <&vreg_1v8>;
		VP-supply = <&vreg_vbat>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";

		cirrus,boost-ctl = <43>;		/* 7.5 V */
		cirrus,boost-ipk = <2756250>;
		cirrus,boost-slew-step = <2>;
		cirrus,boost-coeffs = /bits/ 8 <0x8a 0x10 0x73 0x03>;
		cirrus,trim = /bits/ 8 <0x05 0x04 0xd0>;

		cirrus,hg-algo {
			cirrus,mem-depth = <3>;
			cirrus,release-rate = <128>;
			cirrus,hd-rm = <20>;
			cirrus,ldo-thld = <5>;
			cirrus,ldo-entry-delay = <4>;
			cirrus,vp-hg = <9>;
			cirrus,vp-hg-va = <1>;
		};
	};
};

&spi1 {
	status = "okay";
	/* ADT spi1 function-spi_cs0 = GPIO(0xf, 0x10001): pin 15, active-low */
	cs-gpios = <&pinctrl 15 GPIO_ACTIVE_LOW>;

	/* ADT /arm-io/spi1/audio-codec (audio-control,cs42l67) */
	headset_codec: codec@0 {
		compatible = "cirrus,cs42l67";
		reg = <0>;
		/* iOS runs it at 83 ns (~12 MHz) */
		spi-max-frequency = <1000000>;
		/* ADT interrupts [127 1]; the driver does not use it yet */
		interrupts-extended = <&pinctrl 127 IRQ_TYPE_LEVEL_LOW>;
		/*
		 * iOS asks the codec's MCA0 data nub for MCLK, so the pad is
		 * MCA0's (guess); the MCA2 node provides all five pads.
		 */
		clocks = <&mca2 0>;
		clock-names = "mclk";
		cirrus,xsp-tx-slot = <4>;
		cirrus,xsp-rx-slot = <0>;
		#sound-dai-cells = <1>;
	};
};

&spi2 {
	status = "okay";
	/* ADT spi2 function-spi_cs0 = GPIO(0xb9, 0x10001): pin 185, active-low */
	cs-gpios = <&pinctrl 185 GPIO_ACTIVE_LOW>;

	/* ADT /arm-io/spi2/multi-touch (multi-touch,n61): an N1 (Z2 family) */
	touchscreen@0 {
		compatible = "apple,n61-touchscreen";
		reg = <0>;
		/* iOS runs the link at ~12 MHz; plenty for 56-byte frames */
		spi-max-frequency = <4000000>;
		/* Held low while a frame is pending */
		interrupts-extended = <&pinctrl 3 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
		vdd-supply = <&pmic_ldo15>;
		vdd-ana-supply = <&chestnut_ldo2>;
		clocks = <&touch_clk>;
		firmware-name = "apple/dfrmtfw-n61.bin";
		/* 58.50 x 104.05 mm in 0.01 mm units, origin bottom left */
		touchscreen-size-x = <5850>;
		touchscreen-size-y = <10405>;
		touchscreen-inverted-y;
		/*
		 * apple,z2-cal-blob and apple,z2-prox-cal-blob are filled in
		 * by the bootloader from the ADT.
		 */
	};
};

/* ADT /arm-io/uart3/stockholm: NXP PN548-class NFC controller */
/* The battery's bq27540 gauge, reached over UART5 through the charger */
&swi {
	apple,swi-master = <&charger>;
	power-supplies = <&charger>;
	status = "okay";
};

&serial3 {
	status = "okay";

	nfc {
		compatible = "nxp,pn548-uart";
		/* ADT function-enable / function-download_request */
		enable-gpios = <&pinctrl 177 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&pinctrl 192 GPIO_ACTIVE_HIGH>;
	};
};

&serial1 {
	status = "okay";

	/* ADT /arm-io/uart1/bluetooth: the BT half of a BCM4345 module */
	bluetooth {
		compatible = "brcm,bcm4345c5";
		/*
		 * iOS runs 3 Mbaud with extra divider bits; the S5L divider
		 * alone tops out at 1.5 Mbaud from the 24 MHz clock.
		 */
		max-speed = <1500000>;
		/* ADT function-power_enable: PMU GPIO 8 = BT_REG_ON */
		shutdown-gpios = <&pmic_gpio 8 GPIO_ACTIVE_HIGH>;
		/* ADT function-bt_wake: GPIO 50 */
		device-wakeup-gpios = <&pinctrl 50 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * ADT /arm-io/uart8/oscar: the M8 motion coprocessor. Phase 1 of its
 * bring-up only exposes the UART, the rails and the reset line to userspace
 * (tools/oscar/oscartest); the rails are read-only unless
 * apple_pmic_regulator.oscar_rails=1.
 */
&i2c0 {
	pmic@74 {
		/* ADT function-sensor_power: PP3V0_IMU */
		pmic_ldo4: ldo4@82 {
			compatible = "apple,adi-pmic-ldo4";
			reg = <0x82 0x1>;
			regulator-name = "PP3V0_IMU";
		};

		/* ADT function-oscar_power1: PP1V2_OSCAR (VddCore) */
		pmic_ldo16: ldo16@85 {
			compatible = "apple,adi-pmic-ldo16";
			reg = <0x85 0x1>;
			regulator-name = "PP1V2_OSCAR";
		};

		/* ADT function-oscar_power2: PP1V8_OSCAR (VddIO) */
		pmic_ldo18: ldo18@85 {
			compatible = "apple,adi-pmic-ldo18";
			reg = <0x85 0x1>;
			regulator-name = "PP1V8_OSCAR";
		};
	};
};

&pmic_gpio {
	/* ADT oscar function-reset: PMU GPIO 5, active low */
	gpio-line-names = "", "", "", "", "", "OSCAR_RESET_L",
			  "", "", "BT_REG_ON", "", "WL_REG_ON", "OSCAR_CLK32K";
	/*
	 * PMU GPIO 11: LLB programs cfg 0x08 and iOS never writes it again;
	 * presumably the M8's 32 kHz clock. Keep it away from gpiolib: an
	 * output request would rewrite the cfg, and a cfg with bits 6:3 =
	 * 1000 (0x41) wedged the PMU's I2C bus on hw.
	 */
	gpio-reserved-ranges = <11 1>;
};

/*
 * PMU events (iOS AppleD2186PMU): 3 = "usb" (unused on N61), 24 + n = PMU GPIO n
 * (0 = SN2400 INT, 6 = WLAN host wake, 9 = BT host wake), 88 = RTC alarm.
 */
&pmic_irq {
	status = "okay";
};

&pmic_rtc {
	interrupts-extended = <&pmic_irq 88 IRQ_TYPE_EDGE_RISING>;
	wakeup-source;
};

&serial8 {
	status = "okay";
};

/ {
	oscar-vdd-core {
		compatible = "regulator-output";
		vout-supply = <&pmic_ldo16>;
	};

	oscar-vddio {
		compatible = "regulator-output";
		vout-supply = <&pmic_ldo18>;
	};

	oscar-vdd-imu {
		compatible = "regulator-output";
		vout-supply = <&pmic_ldo4>;
	};
};

&ehci_hsic {
	host-ready-gpios = <&pinctrl 67 GPIO_ACTIVE_HIGH>;
	device-ready-gpios = <&pinctrl 56 GPIO_ACTIVE_HIGH>;
	status = "okay";
};
